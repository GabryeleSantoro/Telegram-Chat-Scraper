# Copy to .env and fill in. Get api_id and api_hash at https://my.telegram.org/auth
api_id=123456
api_hash=your_api_hash

# Source chat to read (if it's a bot, press /start on it from your account first)
chat_name=@pokemon_alert_24_bot

# Where the Italian 30° Anniversario messages are sent: "me" (your chat with the bot), @user, or @channel
target_chat=me

# The bot that sends them, so you get notified (your own messages never notify you).
# Create it with @BotFather (/newbot), then press /start on it from your account (for a channel, make it admin)
bot_token=123456789:your_bot_token
