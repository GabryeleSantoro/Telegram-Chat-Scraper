# Copy to .env and fill in. Get api_id and api_hash at https://my.telegram.org/auth
api_id=123456
api_hash=your_api_hash

# Source chat to read (if it's a bot, press /start on it from your account first)
chat_name=@pokemon_alert_24_bot

# Where the Italian 30° Anniversario messages are sent (@channel, @user, or "me" for Saved Messages)
target_chat=@your_channel
